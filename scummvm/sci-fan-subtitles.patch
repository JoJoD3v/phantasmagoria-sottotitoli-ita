+void Audio32::startSubtitles(const ResourceId resourceId) {
+	Common::String fileName;
+	if (resourceId.getType() == kResourceTypeAudio36) {
+		fileName = Common::String::format("%u-%08X.a36.srt", resourceId.getNumber(), resourceId.getTuple());
+	} else if (resourceId.getType() == kResourceTypeAudio) {
+		fileName = Common::String::format("%u.aud.srt", resourceId.getNumber());
+	} else {
+		return;
+	}
+
+	if (!Common::File::exists(Common::Path(fileName))) {
+		return;
+	}
+
+	if (_subtitles.isLoaded()) {
+		_subtitles.close();
+	}
+
+	_subtitles.loadSRTFile(Common::Path(fileName));
+	if (!_subtitles.isLoaded()) {
+		return;
+	}
+	_subtitlesId = resourceId;
+
+	const int16 overlayWidth = g_system->getOverlayWidth();
+	const int16 overlayHeight = g_system->getOverlayHeight();
+	_subtitles.setBBox(Common::Rect(20, overlayHeight * 58 / 100, overlayWidth - 20, overlayHeight * 76 / 100));
+	_subtitles.setColor(0xff, 0xff, 0xff);
+	_subtitles.setFont("LiberationSans-Regular.ttf");
+}
+
+void Audio32::updateSubtitles() {
+	if (!_subtitles.isLoaded()) {
+		return;
+	}
+
+	const int16 position = getPosition(_subtitlesId);
+	if (position < 0) {
+		// Speech finished
+		_subtitles.close();
+		g_system->hideOverlay();
+		return;
+	}
+
+	const bool reshow = !g_system->isOverlayVisible();
+	if (reshow) {
+		g_system->clearOverlay();
+		g_system->showOverlay(false);
+	}
+	_subtitles.drawSubtitle(position * 1000 / 60, reshow);
+}
