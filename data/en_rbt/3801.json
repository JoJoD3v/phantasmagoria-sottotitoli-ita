[
{
"start": 0.82,
"end": 4.56,
"text": "When you started questioning me about Carno's old estate, I thought"
},
{
"start": 4.56,
"end": 4.98,
"text": "of something."
},
{
"start": 5.32,
"end": 9.62,
"text": "My mother started this scrapbook of important news articles when"
},
{
"start": 9.62,
"end": 10.54,
"text": "she was very young."
},
{
"start": 10.94,
"end": 13.78,
"text": "She added to it almost up until the day she died."
},
{
"start": 13.8,
"end": 15.12,
"text": "That was four years ago."
},
{
"start": 15.68,
"end": 18.98,
"text": "I remembered seeing some old articles about Carno in here, so"
},
{
"start": 18.98,
"end": 19.58,
"text": "I dug it up."
},
{
"start": 20.08,
"end": 21.02,
"text": "This is wonderful."
},
{
"start": 21.62,
"end": 22.88,
"text": "Can I keep it for a while?"
},
{
"start": 23.84,
"end": 26.04,
"text": "Oh, no, I couldn't let it go."
},
{
"start": 26.08,
"end": 26.8,
"text": "It's my mother's."
},
{
"start": 26.8,
"end": 28.18,
"text": "You have to look at it here."
},
{
"start": 28.24,
"end": 28.72,
"text": "I'm sorry."
},
{
"start": 29.06,
"end": 30.06,
"text": "Oh, no problem."
},
{
"start": 30.06,
"end": 31.7,
"text": "I'm just glad you found it."
},
{
"start": 32.92,
"end": 35.0,
"text": "Unfortunately, I may not have time right now."
},
{
"start": 35.36,
"end": 36.48,
"text": "When can I read them?"
},
{
"start": 37.1,
"end": 37.88,
"text": "Any time."
},
{
"start": 38.14,
"end": 40.24,
"text": "I will leave it right here on the counter."
},
{
"start": 40.64,
"end": 42.02,
"text": "Come in whenever you want."
},
{
"start": 42.44,
"end": 43.94,
"text": "Thanks, Lou. I appreciate it."
},
{
"start": 44.32,
"end": 45.18,
"text": "Don't mention it."
}
]