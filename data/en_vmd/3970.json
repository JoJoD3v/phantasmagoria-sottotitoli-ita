[
{
"start": 10.77,
"end": 11.69,
"text": "God, you scared me."
},
{
"start": 12.61,
"end": 13.77,
"text": "And where have you been all day?"
},
{
"start": 14.83,
"end": 19.44,
"text": "I don't know. Around. In town."
},
{
"start": 19.84,
"end": 23.16,
"text": "I thought I told you to stay away from all of those people."
},
{
"start": 24.64,
"end": 25.16,
"text": "People."
},
{
"start": 25.8,
"end": 26.46,
"text": "What people?"
},
{
"start": 27.34,
"end": 28.68,
"text": "Those stupid townspeople."
},
{
"start": 29.68,
"end": 30.76,
"text": "Oh, this is silly."
},
{
"start": 30.98,
"end": 32.36,
"text": "I'm not finished with you yet."
},
{
"start": 33.04,
"end": 34.64,
"text": "You're telling me what to do?"
},
{
"start": 35.26,
"end": 36.44,
"text": "Where were you all day?"
},
{
"start": 37.24,
"end": 38.82,
"text": "None of your business, honey."
},
{
"start": 39.68,
"end": 40.44,
"text": "Well, I'll tell you what."
},
{
"start": 40.5,
"end": 42.88,
"text": "You take care of your business, and I'll take care of mine."
},
{
"start": 46.43,
"end": 47.69,
"text": "Well, we're going to see about that."
}
