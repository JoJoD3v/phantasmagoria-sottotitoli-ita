[
{
"start": 2.7,
"end": 4.94,
"text": "Such a nice day for a picnic, don't you think, honey?"
},
{
"start": 5.66,
"end": 6.78,
"text": "Yeah, I guess so."
},
{
"start": 7.68,
"end": 9.5,
"text": "So good to get you out of that dark room."
},
{
"start": 10.36,
"end": 11.1,
"text": "Yes, Beth."
},
{
"start": 11.58,
"end": 13.02,
"text": "Well, I've got work to do, Adrian."
},
{
"start": 13.76,
"end": 14.86,
"text": "We're not finished yet."
},
{
"start": 16.4,
"end": 17.62,
"text": "Don, it can wait."
},
{
"start": 18.26,
"end": 20.54,
"text": "You need to take some time out to relax."
},
{
"start": 20.84,
"end": 21.94,
"text": "You're so stressed out."
},
{
"start": 23.0,
"end": 25.28,
"text": "I've got publishing deadlines. Can you understand that?"
},
{
"start": 25.76,
"end": 29.04,
"text": "You see, I don't get the same ass-kissing royal treatment your publisher gives you."
},
{
"start": 30.48,
"end": 34.52,
"text": "Don, you say that."
},
{
"start": 34.88,
"end": 36.48,
"text": "I certainly do understand."
},
{
"start": 36.64,
"end": 36.98,
"text": "Deadly."
},
{
"start": 37.28,
"end": 41.08,
"text": "Honey, what's wrong?"
},
{
"start": 42.04,
"end": 42.48,
"text": "Nothing."
},
{
"start": 43.06,
"end": 44.06,
"text": "It's a headache, that's all."
},
{
"start": 45.24,
"end": 45.8,
"text": "But..."
},
{
"start": 45.8,
"end": 46.92,
"text": "I'm gonna go lie down."
},
{
"start": 47.86,
"end": 48.92,
"text": "Maybe you were right."
},
{
"start": 49.56,
"end": 50.62,
"text": "Maybe I need some rest."
},
{
